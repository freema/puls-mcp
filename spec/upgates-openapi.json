{
  "openapi": "3.0.3",
  "info": {
    "title": "Upgates mock API v2 (Prism)",
    "version": "0.0.1",
    "description": "E2E mock fixture for @puls/upgates-client. Examples in lowercase snake_case mirroring Upgates API v2. number_of_pages=1 keeps paginateAll() terminating against a static Prism mock."
  },
  "paths": {
    "/api/v2/orders": {
      "get": {
        "summary": "List orders (paged)",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "last_update_time_from", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Orders page",
            "headers": {
              "X-Rate-Limit-Hour-Remaining": { "schema": { "type": "string" }, "example": "950" },
              "X-Rate-Limit-Day-Remaining": { "schema": { "type": "string" }, "example": "9500" },
              "X-Rate-Limit-Total-Remaining": { "schema": { "type": "string" }, "example": "9500" }
            },
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "current_page": 1,
                  "number_of_pages": 1,
                  "number_of_items": 1,
                  "current_page_items": 1,
                  "orders": [
                    {
                      "code": "UPG-ORDER-001",
                      "status": "Vyřízeno",
                      "paid_yn": "Y",
                      "currency": "CZK",
                      "total_price_with_vat": 1210,
                      "invoice_number": "2026000123",
                      "created_at": "2026-05-01T10:00:00+02:00",
                      "updated_at": "2026-05-02T09:00:00+02:00",
                      "firstname": "Jan",
                      "surname": "Novák",
                      "email": "jan@firma.cz",
                      "company": "Firma s.r.o.",
                      "company_number": "12345678",
                      "vat_number": "CZ12345678"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/orders/{code}": {
      "get": {
        "summary": "Order detail by code",
        "parameters": [
          { "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Order detail",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "order": {
                    "code": "UPG-ORDER-001",
                    "status": "Vyřízeno",
                    "paid_yn": "Y",
                    "currency": "CZK",
                    "total_price_with_vat": 1210,
                    "invoice_number": "2026000123",
                    "created_at": "2026-05-01T10:00:00+02:00",
                    "updated_at": "2026-05-02T09:00:00+02:00",
                    "firstname": "Jan",
                    "surname": "Novák",
                    "email": "jan@firma.cz",
                    "company": "Firma s.r.o.",
                    "company_number": "12345678",
                    "vat_number": "CZ12345678",
                    "products": [
                      {
                        "code": "P1",
                        "title": "Tričko bavlněné",
                        "quantity": 2,
                        "price_with_vat": 605,
                        "vat": 21
                      }
                    ],
                    "shipment": "PPL",
                    "payment": "Kartou"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/products": {
      "get": {
        "summary": "List products (paged)",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Products page",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "current_page": 1,
                  "number_of_pages": 1,
                  "number_of_items": 1,
                  "products": [
                    {
                      "code": "UPG-PROD-001",
                      "ean": "8590000000001",
                      "active_yn": "Y",
                      "manufacturer": "ACME",
                      "price_with_vat": 499,
                      "price_without_vat": 412.4,
                      "currency": "CZK",
                      "stock": 7,
                      "availability": "Skladem",
                      "descriptions": [
                        { "language": "cs", "title": "Tričko", "description": "Bavlněné tričko" },
                        { "language": "en", "title": "T-shirt", "description": "Cotton t-shirt" }
                      ],
                      "categories": [{ "language": "cs", "name": "Oblečení" }]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/products/{code}": {
      "get": {
        "summary": "Product detail by code",
        "parameters": [
          { "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Product detail",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "product": {
                    "code": "UPG-PROD-001",
                    "ean": "8590000000001",
                    "active_yn": "Y",
                    "manufacturer": "ACME",
                    "price_with_vat": 499,
                    "price_without_vat": 412.4,
                    "currency": "CZK",
                    "stock": 7,
                    "availability": "Skladem",
                    "descriptions": [
                      { "language": "cs", "title": "Tričko", "description": "Bavlněné tričko" },
                      { "language": "en", "title": "T-shirt", "description": "Cotton t-shirt" }
                    ],
                    "categories": [{ "language": "cs", "name": "Oblečení" }],
                    "variants": [
                      { "code": "UPG-PROD-001-M", "ean": "8590000000018", "price_with_vat": 499, "stock": 4 }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/customers": {
      "get": {
        "summary": "List customers (paged)",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Customers page",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "current_page": 1,
                  "number_of_pages": 1,
                  "number_of_items": 1,
                  "customers": [
                    {
                      "code": "UPG-CUST-001",
                      "email": "b2b@firma.cz",
                      "firstname": "Eva",
                      "surname": "Malá",
                      "company": "Malá s.r.o.",
                      "company_number": "87654321",
                      "vat_number": "CZ87654321",
                      "customer_pricelist_id": 2
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/customers/{code}": {
      "get": {
        "summary": "Customer detail by code",
        "parameters": [
          { "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Customer detail",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "customer": {
                    "code": "UPG-CUST-001",
                    "email": "b2b@firma.cz",
                    "firstname": "Eva",
                    "surname": "Malá",
                    "company": "Malá s.r.o.",
                    "company_number": "87654321",
                    "vat_number": "CZ87654321",
                    "customer_pricelist_id": 2
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/categories": {
      "get": {
        "summary": "List categories (paged)",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Categories page",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "current_page": 1,
                  "number_of_pages": 1,
                  "number_of_items": 2,
                  "categories": [
                    {
                      "code": "CAT-1",
                      "id": 10,
                      "parent_id": null,
                      "descriptions": [{ "language": "cs", "name": "Oblečení" }]
                    },
                    {
                      "code": "CAT-2",
                      "id": 11,
                      "parent_id": 10,
                      "descriptions": [{ "language": "cs", "name": "Trička" }]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/stocks": {
      "get": {
        "summary": "List stocks / availabilities (paged)",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Stocks page",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "current_page": 1,
                  "number_of_pages": 1,
                  "number_of_items": 2,
                  "stocks": [
                    { "code": "AVAIL-1", "name": "Skladem", "default_yn": "Y" },
                    { "code": "AVAIL-2", "name": "Na objednávku", "default_yn": "N" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/eshop": {
      "get": {
        "summary": "Eshop metadata",
        "responses": {
          "200": {
            "description": "Eshop meta",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "eshop": {
                    "id": 555,
                    "name": "Demo Upgates Shop",
                    "url": "https://demo.upgates.cz",
                    "currency": "CZK",
                    "language": "cs",
                    "vat_payer_yn": "Y"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/owner": {
      "get": {
        "summary": "Eshop owner (for admin_email pairing during activation)",
        "responses": {
          "200": {
            "description": "Owner",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "owner": {
                    "email": "owner@demo-upgates.cz",
                    "name": "Demo Owner"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/webhooks": {
      "get": {
        "summary": "List registered webhooks (idempotency pre-check)",
        "responses": {
          "200": {
            "description": "Registered webhooks",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "webhooks": []
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register a data webhook",
        "responses": {
          "200": {
            "description": "Webhook registered",
            "content": {
              "application/json": {
                "schema": { "type": "object" },
                "example": {
                  "webhook": {
                    "event": "orders",
                    "url": "https://pulsmcp.com/api/webhooks/upgates"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
