APP_PUBLISH=3000
MCP_PUBLISH=3001
DATABASE_URL=postgresql://puls:puls@localhost:5432/puls
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development
PULS_DEV_MCP_KEY=puls-dev-key-change-me
UPGATES_API_BASE_URL=http://localhost:4011
SHOPTET_API_BASE_URL=http://localhost:4010
SHOPTET_CLIENT_ID=mock-client-id
SHOPTET_CLIENT_SECRET=mock-client-secret
SHOPTET_REDIRECT_URI=http://localhost/oauth/callback
ADMIN_EMAIL=admin@example.com
MCP_INTERNAL_URL=http://mcp:3001
MCP_PUBLIC_ORIGIN=http://localhost:3001
WEB_PUBLIC_ORIGIN=http://localhost:3000

# --- E-mail přihlášení (SMTP) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Puls <noreply@example.com>
# PULS_LOG_MAIL=0

# Fallback přes Resend (když SMTP není nastavené)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# --- Ochrana OTP loginu proti zneužití (OTP bombing) ---
# Cloudflare Turnstile (zdarma) — když SECRET není nastavený, captcha se PŘESKAKUJE (dev/E2E).
# Site key je veřejný (jde do HTML), secret key je tajný (server-side ověření).
# TURNSTILE_SITE_KEY=0x4AAAA...
# TURNSTILE_SECRET_KEY=0x4AAAA...
# Kill switch: nastav na 1 a OTP login se OKAMŽITĚ vypne (nouzové opatření proti suspendu schránky).
# OTP_LOGIN_DISABLED=
# Globální pojistka: max OTP e-mailů za hodinu napříč celou appkou (default 50).
# OTP_GLOBAL_HOURLY_MAX=50

# --- Google OAuth (AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET) ---
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Volitelně, když redirect URI v konzoli nesedí s request.origin:
# AUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Sentry (server-side error tracking) ---
# Bez DSN je SDK no-op. DSN je veřejný identifikátor (lze commitnout), ale env je čistší.
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Volitelný override pino log level (debug|info|warn|error). Default: debug v dev, info v prod.
# LOG_LEVEL=debug

# --- Cron joby (trial reminders, retence aktivit, post-trial purge) ---
# Bearer token chrání /api/cron před externím spouštěním.
# Volej z Coolify / GitHub Actions / k8s CronJob:
#   GET https://pulsmcp.com/api/cron?job=all   Header: Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=
# Kolik dní po expiraci trialu mažeme data shopu (default 30).
# TRIAL_GRACE_DAYS=30
