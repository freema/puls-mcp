# ============================================
# Puls — Production env (template, secrets vyplnit při deployi)
# Soubor `.env.production` musí mít všechny hodnoty vyplněné.
# Tento `.env.production.example` je pouze šablona pro repo.
# ============================================

# --- Database & cache ---
# DATABASE_URL=postgresql://puls:<POSTGRES_PASSWORD>@postgres:5432/puls
DATABASE_URL=
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
REDIS_URL=

# --- App basics ---
NODE_ENV=production
LOG_LEVEL=info

# --- Public origins (HTTPS, za nginx reverse proxy) ---
WEB_PUBLIC_ORIGIN=https://pulsmcp.com
MCP_PUBLIC_ORIGIN=https://mcp.pulsmcp.com
# Internal docker network alias — web container volá MCP container přímo
MCP_INTERNAL_URL=http://puls-mcp:3001

# --- Admin ---
ADMIN_EMAIL=admin@example.com

# --- Shoptet OAuth add-on credentials (placeholders) ---
# Do té doby musí mít aspoň validní formát (zod url + non-empty).
SHOPTET_API_BASE_URL=https://api.shoptet.cz
SHOPTET_CLIENT_ID=placeholder-client-id
SHOPTET_CLIENT_SECRET=placeholder-client-secret
SHOPTET_REDIRECT_URI=https://pulsmcp.com/api/install

# --- Cron (chrání /api/cron před externím spuštěním) ---
# CRON_SECRET=<openssl rand -hex 32>
CRON_SECRET=
TRIAL_GRACE_DAYS=30

# --- Email (Resend; SMTP fallback) ---
# Až bude doména pulsmcp.com ověřená v Resendu.
RESEND_API_KEY=
EMAIL_FROM=Puls <noreply@pulsmcp.com>

# SMTP varianta (alternativa k Resend). Zatím nepoužíváme.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Puls <noreply@pulsmcp.com>

# --- Ochrana OTP loginu proti zneužití (OTP bombing) ---
# Cloudflare Turnstile (zdarma). Vytvoř widget na dash.cloudflare.com → Turnstile,
# hostname pulsmcp.com (+ www). Bez SECRET klíče se captcha přeskakuje — v PRODUKCI VYPLŇ!
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Kill switch: nastav na 1 → OTP login se OKAMŽITĚ vypne (přežije i bez redeploye přes redis-cli,
# viz docs). Nouzové opatření, kdyby zase hrozil suspend schránky.
OTP_LOGIN_DISABLED=
# Globální pojistka: max OTP e-mailů za hodinu napříč celou appkou (default 50).
OTP_GLOBAL_HOURLY_MAX=50

# --- Google OAuth (login přes Google) ---
# Vytvořit OAuth 2.0 Client v Google Cloud Console.
# Authorized redirect URI: https://pulsmcp.com/auth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_REDIRECT_URI=https://pulsmcp.com/auth/google/callback

# --- Sentry (server error tracking) ---
# Pozor: zod schema = z.string().url().optional(). Prázdný string ("") FAIL'uje
# url() validátor a appka padne na boot. Buď doplň reálný DSN, nebo nech řádek
# zakomentovaný (= proměnná není v env, optional projde).
# SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
