{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' react-router dev --host 0.0.0.0 --port 3000",
    "start": "NODE_OPTIONS='--import ./instrument.server.mjs' react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "@puls/db": "workspace:*",
    "@puls/platform-core": "workspace:*",
    "@puls/shoptet-client": "workspace:*",
    "@puls/upgates-client": "workspace:*",
    "@react-router/node": "7.14.0",
    "@react-router/serve": "7.14.0",
    "@sentry/react-router": "^10.51.0",
    "drizzle-orm": "^0.41.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.6.0",
    "isbot": "^5.1.26",
    "lucide-react": "^0.469.0",
    "marked": "^14.1.3",
    "nodemailer": "^6.9.16",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "7.14.0",
    "recharts": "^2.15.0",
    "resend": "^4.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@react-router/dev": "7.14.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
